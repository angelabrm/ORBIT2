# Stage 1: install deps
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

# Stage 2: runtime
FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY package.json ./
COPY server.ts ./
COPY src ./src
COPY tsconfig.json ./
ENV NODE_ENV=production
EXPOSE 3000
USER node
CMD ["node_modules/.bin/tsx", "server.ts"]
